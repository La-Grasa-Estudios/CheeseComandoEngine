{
	"pad-default": "downscroll-box",
	"components": [
	{
		"type": "rect",
		"name": "menu-container",
		"width": "100%",
		"height": "100%",
		"transform-x": "20%",
		"transform-y": "10%",
		"background-color": [0.0, 0.0, 0.0, 0.0],
		"camera-layer": 0,
		"render-layer": 10000,
		"font": "vcr",
		"transition-len": 0.5,
		"transition-in": "slide-left",
		"transition-out": "slide-left",
		"font": "vcr",
		"components": [
		{
			"type": "label",
			"transform-x": "0px",
			"transform-y": "0px",
			"font-size": 128,
			"text": "Settings"
		},
		{
			"type": "checkbox",
			"name": "downscroll-box",
			"padding-top": "70px",
			"width": "130px",
			"height": "130px",
			"unhovered-color": [ 0.75, 0.75, 0.75, 1.0 ],
			"onHover": "sfx-ui",
			"uimg": "ui/rsc/fnf-checkbox.uimg",
			"background-color": [1.0, 1.0, 1.0, 1.0],
			"camera-layer": 0,
			"render-layer": 10000,
			"down": "botplay-box",
			"components": [
			{
				"type": "label",
				"transform-x": "200px",
				"transform-y": "35px",
				"transition-offset": 0.0,
				"text": "Downscroll"
			}
			]
		},
		{
			"type": "checkbox",
			"name": "botplay-box",
			"padding-top": "70px",
			"width": "130px",
			"height": "130px",
			"unhovered-color": [ 0.75, 0.75, 0.75, 1.0 ],
			"onHover": "sfx-ui",
			"uimg": "ui/rsc/fnf-checkbox.uimg",
			"background-color": [1.0, 1.0, 1.0, 1.0],
			"camera-layer": 0,
			"render-layer": 10000,
			"up": "downscroll-box",
			"components": [
			{
				"type": "label",
				"transform-x": "200px",
				"transform-y": "35px",
				"transition-offset": 0.0,
				"text": "Botplay"
			}
			]
		}
		]
	}
	]
}

