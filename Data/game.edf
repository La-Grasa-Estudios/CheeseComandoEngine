{
	"datatypes": [
		{
			"gui_anchor_point": {
				"type": "enum",
				"display": "Anchor Point",
				"values": [
					"center",
					"top",
					"bottom",
					"left",
					"right",
					"top_left",
					"top_right",
					"bottom_left",
					"bottom_right"
				]
			}
		}
	],
	"_comment": "Component names should match those registered with the DECLARE_COMPONENT macro, as well the field names should match those of their respective DECLARE_COMPONENT_FIELD macro",
	"components": [
		{
			"name": {
				"description": "Name tag",
				"fields": [
					{
						"_comment": "Name: name, hilarious isn't it?",
						"name": "Name",
						"type": "string",
						"description": "Entity runtime name, can be used as a tag"
					}
				]
			}
		},
		{
			"transform": {
				"description": "Spacial component for entities",
					"fields": [
					{
						"name": "Parent",
						"description": "Transform parent",
						"type": "entity"
					},
					{
						"name": "Position",
						"description": "World space position or parent space position of the transform",
						"type": "vec3"
					},
					{
						"name": "Scale",
						"description": "Transform scale",
						"type": "vec3",
						"default": [ 1.0, 1.0, 1.0 ]
					},
					{
						"name": "Rotation",
						"description": "Transform rotation",
						"type": "quat",
						"displayas": "euler",
						"default": [ 0.0, 0.0, 0.0, 1.0 ]
					}
				]
			}
		},
		{
			"mesh_renderer": {
				"requires": ["transform"],
				"description": "Used in 3D rendering, on runtime it contains all mesh subsets and material references needed for rendering, for mesh loading use dynamic_mesh",
				"fields": [
					{
						"name": "CastShadows",
						"display": "Cast Shadows",
						"description": "Does this renderer cast shadows",
						"type": "bool",
						"default": true
					}
				]
			}
		},
		{
			"dynamic_mesh": {
				"requires": ["mesh_renderer"],
				"description": "Used to precache stuff needed for the creation or population of the mesh_renderer component",
				"fields": [
					{
						"name": "Path",
						"description": "Path to the model file (MDL [Recommended], GLTF)",
						"type": "string"
					}
				]
			}
		},
		{
			"sprite_loader": {
				"requires": ["sprite_renderer"],
				"description": "Used to precache stuff needed for the creation or population of the sprite_renderer component",
				"fields": [
					{
						"name": "SpritePath",
						"display": "Sprite Path",
						"description": "Path to the sprite or texture atlas image asset",
						"type": "string"
					},
					{
						"name": "RectSize",
						"display": "Rect Size",
						"description": "Defines the rect size used to crop the texture while rendering",
						"type": "ivec2"
					},
					{
						"name": "RectPosition",
						"display": "Rect Position",
						"description": "Defines the offset of the rect used to crop the texture while rendering",
						"type": "ivec2"
					}
				]
			}
		},
		{
			"sprite_renderer": {
				"requires": ["transform"],
				"description": "Used to render sprites to the screen in 2d mode",
				"fields": [
					{
						"name": "RenderLayer",
						"display": "Rendering Layer",
						"description": "The render layer of the sprite",
						"type": "uint"
					},
					{
						"name": "Center",
						"description": "Defaults to the rect center that is used while rendering, can be used to offset the sprite",
						"type": "vec2"
					},
					{
						"name": "Rotation",
						"description": "Sprite rotation in the X & Y axis, expressed in euler angles, less cumbersome than using transform's rotation",
						"type": "vec2"
					},
					{
						"name": "SpriteColor",
						"display": "Sprite Color",
						"description": "Sprite's tint color, applied like (texture_color * sprite_color)",
						"type": "color",
						"default": [ 1.0, 1.0, 1.0, 1.0 ]
					},
					{
						"name": "IsGui",
						"display": "In Gui Layer",
						"description": "Is checked renders the sprite to another layer",
						"type": "bool"
					},
					{
						"name": "FlipX",
						"display": "Flip Horizontal",
						"description": "Self Explanatory",
						"type": "bool"
					},
					{
						"name": "FlipY",
						"display": "Flip Vertical",
						"description": "Self Explanatory",
						"type": "bool"
					},
					{
						"name": "UseNearestTextureFilter",
						"display": "Is Pixel Sprite",
						"description": "Renders without texture filtering",
						"type": "bool"
					}
				]
			}
		},
		{
			"sprite_animator": {
				"requires": ["sprite_renderer"],
				"description": "Used to animate sprites based on Adobe's SparrowV2 atlas",
				"fields": [
					{
						"name": "CurrentAnimation",
						"display": "Starting Animation State",
						"type": "string"
					},
					{
						"name": "DefaultAnimation",
						"display": "Default animation state",
						"description": "Animation state to transition to when another state that has transition to default property set",
						"type": "string"
					}
				]
			}
		},
		{
			"gui_anchor": {
				"requires": ["transform"],
				"description": "Anchors an entity in virtual screen space, requires a transform to work",
				"fields": [
					{
						"name": "Position",
						"description": "Offset position relative to anchored position",
						"type": "vec2"
					},
					{
						"name": "Anchor Point",
						"description": "Anchor point on the screen",
						"type": "gui_anchor_point",
						"default": "center"
					}
				]
			}
		},
		{
			"video_surface": {
				"description": "Video player, renders the video to a texture that can be applied to any material or sprite",
				"fields": [
					{
						"name": "Path",
						"description": "Path to video file (MP4, WEBM, BIK)",
						"type": "string"
					},
					{
						"name": "PlayAudio",
						"display": "Play Audio",
						"description": "Determines if the video player should output the audio track",
						"type": "bool",
						"default": true
					}
				]
			}
		},
		{
			"text_component": {
				"description": "Base text component, used to store actual UNICODE text",
				"fields": [
					{
						"name": "Font",
						"description": "Font used to render the text",
						"type": "string"
					},
					{
						"name": "FontSize",
						"display": "Font Size",
						"type": "float",
					},
					{
						"name": "Text",
						"description": "Text =)",
						"type": "wstring"
					}
				]
			}
		},
		{
			"text_renderer": {
				"requires": ["text_component"],
				"description": "Renders the attached text_component to the screen",
				"fields": [
				{
					"name": "Enabled",
					"type": "bool"
				},
				{
					"name": "RenderLayer",
					"display": "Rendering Layer",
					"description": "The render layer of the sprite",
					"type": "uint"
				},
				{
					"name": "IsGui",
					"display": "In Gui Layer",
					"description": "Is checked renders the text to another layer",
					"type": "bool"
				},
				{
					"name": "Alignment",
					"description": "0 means left aligned, 0.5 means center aligned, 1 means right aligned",
					"type": "bool"
				},
				{
					"name": "Color",
					"display": "Text Color",
					"description": "Text's tint color",
					"type": "color",
					"default": [ 1.0, 1.0, 1.0, 1.0 ]
				}
				]
			}
		}
	]
}